# Variables de entorno requeridas para FitGen
# Copia este archivo como .env.development o .env.production según tu entorno

# URL del backend
# Producción / dev contra datos reales: https://fit-gen-backend.vercel.app
# Backend local: http://localhost:3000
VITE_BACKEND_URL=

# Emuladores Firebase (opcional, solo con firebase emulators:start)
# VITE_USE_FIREBASE_EMULATORS=true

# Configuración de Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=